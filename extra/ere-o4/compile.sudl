MODULE compile ;
  # Thompson‐construction of an NFA from the parsed ERE AST.

  USES MODULE parse AS P, MODULE std AS std ;

  # ---- TYPES ----
  TYPE
    # A transition symbol: literal character, wildcard, or ε
    Symbol =
      | SC   ( c : CHAR )   # single character
      | SAny ()             # '.' wildcard
      | SEps  ()            # ε‐transition
    ;;

    # One directed transition in the NFA
    Transition = RECORD
      from   : U32 ;
      to     : U32 ;
      on     : Symbol ;
      greedy : BOOL ;        # only used for ε‐transitions (quantifier order)
    ENDRECORD ;

    # A nondeterministic‐finite‐automaton fragment
    NFA = RECORD
      start      : U32 ;               # entry state
      accept     : U32 ;               # accepting state
      transitions : ARRAY OF Transition ;
    ENDRECORD ;
  ENDTYPE

  # ---- GLOBAL STATE ----
  VAR nextState : U32 ;               # for fresh state IDs

  # ---- HELPERS ----

  # Allocate and return a new unique state ID
  FUNC newState () -> U32 ;
  VAR s : U32 ;
  BEGIN
    s := nextState ;
    nextState := nextState + 1u ;
    RETURN s ;
  ENDFUNC

  # Append a transition to an NFA in place
  PROC addTrans (
    VAR nfa    : NFA,
        from   : U32,
        to     : U32,
        on     : Symbol,
        greedy? : BOOL = TRUE
  ) ;
  VAR t : Transition ;
  BEGIN
    t.from   <- from ;
    t.to     <- to ;
    t.on     <- on ;
    t.greedy <- greedy? ;
    nfa.transitions <- APPEND(nfa.transitions, t) ;
  ENDPROC

  # Build the simplest two‐state NFA for one Symbol
  FUNC fragBasic ( sym : Symbol ) -> NFA ;
  VAR nfa : NFA ;
  BEGIN
    nfa.start      <- newState() ;
    nfa.accept     <- newState() ;
    nfa.transitions <- [] : ARRAY OF Transition ;
    addTrans(nfa, nfa.start, nfa.accept, sym, TRUE) ;
    RETURN nfa ;
  ENDFUNC

  # ---- THOMPSON CONSTRUCTION ----

  # Entry‐point: from a parse.ERE AST, return a full NFA
  FUNC buildNFA ( ast : P.ERE ) -> NFA ;
  VAR
    left, right, sub : NFA ;
    result           : NFA ;
    i                : U32 ;
  BEGIN
    CASE ast OF

      # Literal character
      | P.EChar(c) =>
          RETURN fragBasic(SC(c)) ;

      # Wildcard '.'
      | P.EAny() =>
          RETURN fragBasic(SAny()) ;

      # Anchors become special literal symbols '^' and '$'
      | P.EStart() =>
          RETURN fragBasic(SC('^')) ;
      | P.EEnd()   =>
          RETURN fragBasic(SC('$')) ;

      # Concatenation of a non‐empty array of sub‐expressions
      | P.EConcat(parts) =>
          ASSERT std.LENGTH(parts) > 0u ;
          # Build first fragment
          left := buildNFA(parts[0u]) ;
          # Sequentially append each subsequent fragment
          FOR i IN 1u .. std.LENGTH(parts)-1u DO
            right := buildNFA(parts[i]) ;
            # combine transitions
            left.transitions <- left.transitions ++ right.transitions ;
            # ε‐link from old accept to new start
            addTrans(left, left.accept, right.start, SEps(), TRUE) ;
            # new accept is that of the right fragment
            left.accept <- right.accept ;
          OD ;
          RETURN left ;

      # Alternation a|b
      | P.EAlt(lAst, rAst) =>
          result.start      <- newState() ;
          result.accept     <- newState() ;
          result.transitions <- [] : ARRAY OF Transition ;
          left  := buildNFA(lAst) ;
          right := buildNFA(rAst) ;
          # ε from new start to both sub‐starts
          addTrans(result, result.start, left.start,  SEps(), TRUE) ;
          addTrans(result, result.start, right.start, SEps(), TRUE) ;
          # absorb sub‐transitions
          result.transitions <- result.transitions
                              ++ left.transitions
                              ++ right.transitions ;
          # ε from each sub‐accept to new accept
          addTrans(result, left.accept,  result.accept, SEps(), TRUE) ;
          addTrans(result, right.accept, result.accept, SEps(), TRUE) ;
          RETURN result ;

      # Kleene star: zero or more
      | P.EStar(subAst, greedy?) =>
          result.start      <- newState() ;
          result.accept     <- newState() ;
          result.transitions <- [] : ARRAY OF Transition ;
          sub := buildNFA(subAst) ;
          # ε‐enter
          addTrans(result, result.start,  sub.start,  SEps(), greedy?) ;
          # ε‐skip (zero occurrences)
          addTrans(result, result.start,  result.accept, SEps(), greedy?) ;
          # ε‐loop back
          addTrans(result, sub.accept,     sub.start,  SEps(), greedy?) ;
          # ε‐exit
          addTrans(result, sub.accept,     result.accept, SEps(), greedy?) ;
          # include sub transitions
          result.transitions <- result.transitions ++ sub.transitions ;
          RETURN result ;

      # Plus closure: one or more = concat(sub, star(sub))
      | P.EPlus(subAst, greedy?) =>
          left  := buildNFA(subAst) ;
          right := buildNFA(P.EStar(subAst, greedy?)) ;
          result.start      <- left.start ;
          result.accept     <- newState() ;
          result.transitions <- left.transitions ++ right.transitions ;
          # ε from left.accept into star‐fragment
          addTrans(result, left.accept, right.start, SEps(), TRUE) ;
          # ε from star.accept to overall accept
          addTrans(result, right.accept, result.accept, SEps(), TRUE) ;
          RETURN result ;

      # Optional: zero or one
      | P.EOpt(subAst, greedy?) =>
          result.start      <- newState() ;
          result.accept     <- newState() ;
          result.transitions <- [] : ARRAY OF Transition ;
          sub := buildNFA(subAst) ;
          # ε‐skip
          addTrans(result, result.start, result.accept, SEps(), greedy?) ;
          # ε‐enter sub
          addTrans(result, result.start, sub.start,    SEps(), greedy?) ;
          # include sub transitions
          result.transitions <- result.transitions ++ sub.transitions ;
          # ε‐exit sub
          addTrans(result, sub.accept, result.accept,  SEps(), greedy?) ;
          RETURN result ;

      # Interval {min,max}
      | P.ERept(subAst, min, max, greedy?) =>
          # 1) build exactly min concatenations
          IF min = 0u THEN
            result.start      <- newState() ;
            result.accept     <- result.start ;
            result.transitions <- [] : ARRAY OF Transition ;
          ELSE
            result := buildNFA(subAst) ;
            FOR i IN 2u .. min DO
              sub := buildNFA(subAst) ;
              result.transitions <- result.transitions ++ sub.transitions ;
              addTrans(result, result.accept, sub.start, SEps(), TRUE) ;
              result.accept <- sub.accept ;
            OD ;
          FI ;
          # 2) optional up to max
          IF max = UINT_MAX THEN
            # behave like star
            sub := buildNFA(P.EStar(subAst, greedy?)) ;
            result.transitions <- result.transitions ++ sub.transitions ;
            addTrans(result, result.accept, sub.start, SEps(), greedy?) ;
            addTrans(result, result.accept, sub.accept, SEps(), greedy?) ;
            result.accept <- sub.accept ;
          ELSE
            FOR i IN min+1u .. max DO
              sub := buildNFA(subAst) ;
              # skip this occurrence
              addTrans(result, result.accept, sub.accept, SEps(), greedy?) ;
              # take this occurrence
              addTrans(result, result.accept, sub.start,  SEps(), greedy?) ;
              result.transitions <- result.transitions ++ sub.transitions ;
              result.accept     <- sub.accept ;
            OD ;
          FI ;
          RETURN result ;

      # Grouping does not alter structure
      | P.EGroup(subAst) =>
          RETURN buildNFA(subAst) ;

      # Character class [...]
      | P.EClass(neg, elems) =>
          result.start      <- newState() ;
          result.accept     <- newState() ;
          result.transitions <- [] : ARRAY OF Transition ;
          VAR e : P.ClassElem ;
          FOR EACH e IN elems DO
            CASE e OF
              | P.CSingle(c) =>
                  addTrans(result, result.start, result.accept, SC(c), TRUE) ;
              | P.CRange(lo, hi) =>
                  VAR cc : CHAR ;
                  FOR cc IN lo .. hi DO
                    addTrans(result, result.start, result.accept, SC(cc), TRUE) ;
                  OD ;
            ENDCASE
          OD ;
          # Negation of a class will be handled in the match phase
          # (we leave a marker transition)
          IF neg THEN
            addTrans(result, result.start, result.accept, SEps(), TRUE) ;
          FI ;
          RETURN result ;

    ENDCASE
  ENDFUNC

  EXPORT buildNFA ;

ENDMODULE ;

