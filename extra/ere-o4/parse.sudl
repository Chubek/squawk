MODULE parse ;
  # Parser for POSIX‐style Extended Regular Expressions (ERE)
  # Produces an abstract syntax tree (AST) of type ERE.

  IMPORT std ;    # Assume std provides LENGTH(s:STRING)->U32 and error(s:STRING)

  # ---- AST DEFINITIONS ----

  TYPE
    # A single element inside a character class
    ClassElem =
      | CSingle ( c : CHAR )
      | CRange  ( lo, hi : CHAR )
    ;;

    # The core ERE AST
    ERE =
      | EChar     ( c       : CHAR        )        # literal character
      | EAny      ()                              # '.' matches any character
      | EStart    ()                              # '^' anchor at beginning
      | EEnd      ()                              # '$' anchor at end
      | EConcat   ( parts   : ARRAY OF ERE       )# implicit concatenation of subexpressions
      | EAlt      ( left, right : ERE            )# alternation 'a|b'
      | EStar     ( sub      : ERE, greedy : BOOL)# Kleene * (zero or more)
      | EPlus     ( sub      : ERE, greedy : BOOL)# + (one or more)
      | EOpt      ( sub      : ERE, greedy : BOOL)# ? (zero or one)
      | ERept     ( sub      : ERE,
                   min, max : U32,
                   greedy   : BOOL )             # {min,max}
      | EGroup    ( sub      : ERE               )# (…) grouping
      | EClass    ( neg      : BOOL,
                   elems    : ARRAY OF ClassElem )# […] bracket expression
    ;;
  ENDTYPE

  # ---- PARSER STATE ----
  VAR
    pattern : STRING ;
    pos     : U32 ;
    len     : U32 ;
  ;

  # Initialize parser state before each parse
  PROC initParse ( input : STRING ) ;
  BEGIN
    pattern <- input ;
    pos     <- 0u ;
    len     <- std.LENGTH(input) ;
  ENDPROC ;

  # Peek next character without consuming (or '\0' at end)
  FUNC peek () -> CHAR ;
  BEGIN
    IF pos < len THEN
      RETURN pattern[pos] ;
    ELSE
      RETURN '\0' ;
    FI
  ENDFUNC ;

  # Consume and return next character (or '\0' at end)
  FUNC nextChar () -> CHAR ;
  VAR c : CHAR ;
  BEGIN
    c <- peek() ;
    IF pos < len THEN
      pos <- pos + 1u ;
    FI ;
    RETURN c ;
  ENDFUNC ;

  # If next char matches 'c', consume it and return TRUE; else return FALSE
  FUNC matchChar ( c : CHAR ) -> BOOL ;
  BEGIN
    IF peek() = c THEN
      pos <- pos + 1u ;
      RETURN TRUE ;
    ELSE
      RETURN FALSE ;
    FI
  ENDFUNC ;

  # Parse a non‐empty unsigned integer (for {m,n})
  FUNC parseUInt () -> U32 ;
  VAR
    startPos : U32 ;
    value     : U32 ;
    digitCh   : CHAR ;
  BEGIN
    startPos <- pos ;
    value     <- 0u ;
    WHILE TRUE DO
      digitCh <- peek() ;
      IF digitCh >= '0' AND digitCh <= '9' THEN
        value <- value * 10u + (ORD(digitCh) - ORD('0')) ;
        pos   <- pos + 1u ;
      ELSE
        BREAK ;
      FI
    OD ;
    IF pos = startPos THEN
      std.error("Expected a digit at position " + TOSTRING(pos)) ;
    FI ;
    RETURN value ;
  ENDFUNC ;

  # ---- RECURSIVE‐DESCENT PARSER ----

  # Entry point: parse an entire ERE and ensure full consumption
  FUNC parseERE ( input : STRING ) -> ERE ;
  VAR
    expr : ERE ;
  BEGIN
    initParse(input) ;
    expr <- parseAlt() ;
    IF pos <> len THEN
      std.error("Unexpected character '" + TOSTRING(peek()) +
                "' at position " + TOSTRING(pos)) ;
    FI ;
    RETURN expr ;
  ENDFUNC ;

  # parse alternation: Concat { '|' Concat }
  FUNC parseAlt () -> ERE ;
  VAR
    leftExpr, rightExpr : ERE ;
  BEGIN
    leftExpr <- parseConcat() ;
    IF matchChar('|') THEN
      rightExpr <- parseAlt() ;
      RETURN EAlt(leftExpr, rightExpr) ;
    ELSE
      RETURN leftExpr ;
    FI
  ENDFUNC ;

  # parse concatenation: one or more Quantified
  FUNC parseConcat () -> ERE ;
  VAR
    items  : ARRAY OF ERE ;
    sub    : ERE ;
  BEGIN
    items <- [] : ARRAY OF ERE ;
    # Continue parsing as long as next token can start a primary
    WHILE TRUE DO
      CASE peek() OF
        '\0', ')', '|'  : BREAK ;  # end of this concatenation
        ELSE
          sub <- parseQuantified() ;
          items <- APPEND(items, sub) ;
      ENDCASE
    OD ;
    IF std.LENGTH(items) = 0u THEN
      std.error("Empty concatenation at position " + TOSTRING(pos)) ;
    ELSIF std.LENGTH(items) = 1u THEN
      RETURN items[0] ;       # single element: no concat node needed
    ELSE
      RETURN EConcat(items) ;
    FI
  ENDFUNC ;

  # parse a primary, possibly followed by a quantifier
  FUNC parseQuantified () -> ERE ;
  VAR
    base   : ERE ;
    gflag  : BOOL ;
    lo, hi : U32 ;
  BEGIN
    base <- parsePrimary() ;

    # Now check for quantifier operators: *, +, ?, {m,n}
    gflag <- TRUE ;  # default greedy
    IF matchChar('*') THEN
      # Non‐greedy supported via trailing '?' (POSIX extension)?
      IF matchChar('?') THEN gflag <- FALSE FI ;
      RETURN EStar(base, gflag) ;
    ELSIF matchChar('+') THEN
      IF matchChar('?') THEN gflag <- FALSE FI ;
      RETURN EPlus(base, gflag) ;
    ELSIF matchChar('?') THEN
      IF matchChar('?') THEN gflag <- FALSE FI ;
      RETURN EOpt(base, gflag) ;
    ELSIF matchChar('{') THEN
      # parse {m[ ,n ]} then expect '}'
      lo <- parseUInt() ;
      IF matchChar(',') THEN
        IF peek() <> '}' THEN
          hi <- parseUInt() ;
        ELSE
          hi <- UINT_MAX ;   # unbounded
        FI ;
      ELSE
        hi <- lo ;          # exact repetition
      FI ;
      IF NOT matchChar('}') THEN
        std.error("Unterminated '{' at position " + TOSTRING(pos)) ;
      FI ;
      IF matchChar('?') THEN
        gflag <- FALSE ;
      FI ;
      RETURN ERept(base, lo, hi, gflag) ;
    ELSE
      RETURN base ;
    FI
  ENDFUNC ;

  # parse a single‐character ERE or group or class
  FUNC parsePrimary () -> ERE ;
  VAR
    c : CHAR ;
    elems : ARRAY OF ClassElem ;
    neg   : BOOL ;
    lo, hi: CHAR ;
    first : CHAR ;
  BEGIN
    c <- peek() ;

    # Anchor '^'
    IF c = '^' THEN
      pos <- pos + 1u ;
      RETURN EStart() ;
    FI ;

    # Anchor '$'
    IF c = '$' THEN
      pos <- pos + 1u ;
      RETURN EEnd() ;
    FI ;

    # Grouping '(' … ')'
    IF matchChar('(') THEN
      # Note: POSIX allows unmatched '()' to error
      VAR sub : ERE ;
      sub <- parseAlt() ;
      IF NOT matchChar(')') THEN
        std.error("Unmatched '(' at position " + TOSTRING(pos)) ;
      FI ;
      RETURN EGroup(sub) ;
    FI ;

    # Character class '[' … ']'
    IF matchChar('[') THEN
      neg   <- FALSE ;
      elems <- [] : ARRAY OF ClassElem ;
      IF matchChar('^') THEN neg <- TRUE FI ;
      # Special case: ']' at start is literal
      IF peek() = ']' THEN
        elems <- APPEND(elems, CSingle(']')) ;
        pos <- pos + 1u ;
      FI ;
      # Parse elements until closing ']'
      WHILE TRUE DO
        IF peek() = '\0' THEN
          std.error("Unterminated '[' at position " + TOSTRING(pos)) ;
        ELSIF peek() = ']' THEN
          pos <- pos + 1u ;
          BREAK ;
        FI ;
        # Parse one element: possible range
        first <- nextChar() ;
        IF peek() = '-' AND pattern[pos+1u] <> ']' THEN
          # it's a range
          pos <- pos + 1u ;        # consume '-'
          hi  <- nextChar() ;
          elems <- APPEND(elems, CRange(first, hi)) ;
        ELSE
          # single character
          elems <- APPEND(elems, CSingle(first)) ;
        FI ;
      OD ;
      RETURN EClass(neg, elems) ;
    FI ;

    # Wildcard '.'
    IF matchChar('.') THEN
      RETURN EAny() ;
    FI ;

    # Backslash escape: treat next char literally
    IF matchChar('\\') THEN
      c <- nextChar() ;
      IF c = '\0' THEN
        std.error("Dangling '\\' at end of pattern") ;
      FI ;
      RETURN EChar(c) ;
    FI ;

    # Ordinary character
    IF c = '\0' THEN
      std.error("Unexpected end of pattern at position " + TOSTRING(pos)) ;
    ENDIF ;
    # anything else is literal
    pos <- pos + 1u ;
    RETURN EChar(c) ;
  ENDFUNC ;

ENDMODULE ;

