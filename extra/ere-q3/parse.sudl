(* parse.sudl *)
(* Module for parsing Extended Regular Expressions (ERE) into an Abstract Syntax Tree (AST) *)

MODULE "parse.sudl"

USES "MODULE" "common.sudl" AS Common;

(* === AST Node Types === *)

(* Base type for all AST nodes *)
TYPE ASTNode = RECORD {
    type: Common.NodeType; (* Discriminator for the node type *)
}

(* Represents a single character literal *)
TYPE CharNode = RECORD {
    base: ASTNode; (* type = CHAR_NODE *)
    char: U32;     (* The character value (Unicode code point) *)
}

(* Represents the '.' (any character except NUL) *)
TYPE DotNode = RECORD {
    base: ASTNode; (* type = DOT_NODE *)
}

(* Represents an escape sequence like \n, \t, or escaped special chars *)
TYPE EscapeNode = RECORD {
    base: ASTNode; (* type = ESCAPE_NODE *)
    sequence: U32; (* The interpreted character value *)
}

(* Represents concatenation of two expressions *)
TYPE ConcatNode = RECORD {
    base: ASTNode; (* type = CONCAT_NODE *)
    left: ^ASTNode;
    right: ^ASTNode;
}

(* Represents alternation (|) *)
TYPE AlternationNode = RECORD {
    base: ASTNode; (* type = ALTERNATION_NODE *)
    left: ^ASTNode;
    right: ^ASTNode;
}

(* Base for quantifier nodes *)
TYPE QuantifierNode = RECORD {
    base: ASTNode; (* type will be KLEENE, PLUS, etc. *)
    child: ^ASTNode;
    greedy: BOOLEAN; (* TRUE for greedy, FALSE for non-greedy *)
}

(* Specific quantifier types inherit from QuantifierNode *)
TYPE KleeneNode = RECORD {
    base: QuantifierNode; (* base.base.type = KLEENE_NODE *)
}

TYPE PlusNode = RECORD {
    base: QuantifierNode; (* base.base.type = PLUS_NODE *)
}

TYPE QuestionNode = RECORD {
    base: QuantifierNode; (* base.base.type = QUESTION_NODE *)
}

(* Represents {m,n} boundaries *)
TYPE BoundaryNode = RECORD {
    base: QuantifierNode; (* base.base.type = BOUNDARY_NODE *)
    min: I32; (* -1 if omitted *)
    max: I32; (* -1 if omitted *)
}

(* Represents a grouped expression (...) *)
TYPE GroupNode = RECORD {
    base: ASTNode; (* type = GROUP_NODE *)
    child: ^ASTNode;
    group_id: I32; (* For backreference tracking, if needed later *)
}

(* Represents a bracket expression [...] *)
TYPE BracketNode = RECORD {
    base: ASTNode; (* type = BRACKET_NODE *)
    chars: ARRAY[256] OF U32; (* List of individual characters *)
    char_count: I32;
    ranges: ARRAY[128] OF RECORD { start: U32; end: U32; }; (* List of character ranges *)
    range_count: I32;
    classes: ARRAY[16] OF Common.CharClass; (* List of character classes like [:digit:] *)
    class_count: I32;
    negated: BOOLEAN; (* TRUE if [^...] *)
}

(* === Parser State === *)

(* Internal state for the parser *)
TYPE ParserState = RECORD {
    input: ^U8;        (* Pointer to the input string *)
    position: I32;     (* Current parsing position *)
    length: I32;       (* Length of the input string *)
    error: BOOLEAN;    (* Flag indicating a parse error *)
    error_msg: ARRAY[256] OF U8; (* Error message buffer *)
    group_counter: I32; (* To assign unique IDs to groups *)
}

(* === Parser Functions === *)

(* Main parsing function *)
PROC ParseERE(input_str: ^U8, length: I32) -> ^ASTNode;
VAR
    state: ParserState;
    result: ^ASTNode;
BEGIN
    (* Initialize parser state *)
    state.input := input_str;
    state.position := 0;
    state.length := length;
    state.error := FALSE;
    state.group_counter := 0;
    (* Clear error message *)
    FOR i := 0 TO 255 DO
        state.error_msg[i] := 0;
    ENDFOR;
    
    (* Start parsing from the lowest precedence operator (alternation) *)
    result := parse_alternation(state);
    
    (* Check for trailing characters *)
    IF NOT state.error AND state.position < state.length THEN
        set_error(state, "Unexpected character at end of expression");
        (* Clean up partially parsed tree if necessary *)
        IF result # NIL THEN
            destroy_ast(result);
            result := NIL;
        ENDIF;
    ENDIF;
    
    IF state.error THEN
        (* Log or handle error *)
        (* For now, we just return NIL *)
        RETURN NIL;
    ENDIF;
    
    RETURN result;
ENDPROC;

(* Parses alternation (lowest precedence) *)
PROC parse_alternation(VAR state: ParserState) -> ^ASTNode;
VAR
    left: ^ASTNode;
    right: ^ASTNode;
    node: ^AlternationNode;
BEGIN
    left := parse_sequence(state);
    IF state.error THEN RETURN NIL; ENDIF;
    
    IF state.position < state.length AND get_char(state) = ORD('|') THEN
        consume_char(state); (* Consume '|' *)
        right := parse_alternation(state); (* Recurse for right associativity or further alternations *)
        IF state.error THEN
            destroy_ast(left);
            RETURN NIL;
        ENDIF;
        
        (* Create AlternationNode *)
        ALLOCATE(node, 1);
        node.base.base.type := Common.ALTERNATION_NODE;
        node.base.left := left;
        node.base.right := right;
        RETURN CAST<^ASTNode>(node);
    ENDIF;
    
    RETURN left;
ENDPROC;

(* Parses a sequence (concatenation) *)
PROC parse_sequence(VAR state: ParserState) -> ^ASTNode;
VAR
    left: ^ASTNode;
    right: ^ASTNode;
    node: ^ConcatNode;
BEGIN
    left := parse_term(state);
    IF state.error THEN RETURN NIL; ENDIF;
    
    (* Check if we can continue with another term (implicit concatenation) *)
    (* This is a bit tricky. We need to peek ahead to see if the next token starts a new term *)
    (* A new term can start with: literal char, '.', '(', '[', '\' *)
    IF state.position < state.length AND is_term_start(state) THEN
        right := parse_sequence(state); (* Recurse to parse the rest of the sequence *)
        IF state.error THEN
            destroy_ast(left);
            RETURN NIL;
        ENDIF;
        
        (* Create ConcatNode *)
        ALLOCATE(node, 1);
        node.base.base.type := Common.CONCAT_NODE;
        node.base.left := left;
        node.base.right := right;
        RETURN CAST<^ASTNode>(node);
    ENDIF;
    
    RETURN left;
ENDPROC;

(* Helper to check if current position starts a term *)
PROC is_term_start(VAR state: ParserState) -> BOOLEAN;
VAR ch: U32;
BEGIN
    IF state.position >= state.length THEN RETURN FALSE; ENDIF;
    ch := get_char(state);
    RETURN ch # ORD('|') AND ch # ORD(')'); (* Simplified check *)
ENDPROC;

(* Parses a term (atom possibly followed by a quantifier) *)
PROC parse_term(VAR state: ParserState) -> ^ASTNode;
VAR
    atom: ^ASTNode;
    result: ^ASTNode;
BEGIN
    atom := parse_atom(state);
    IF state.error THEN RETURN NIL; ENDIF;
    
    result := parse_quantifier(state, atom);
    IF state.error THEN
        destroy_ast(atom);
        RETURN NIL;
    ENDIF;
    
    RETURN result;
ENDPROC;

(* Parses an atom (basic unit of an ERE) *)
PROC parse_atom(VAR state: ParserState) -> ^ASTNode;
VAR ch: U32;
BEGIN
    IF state.position >= state.length THEN
        set_error(state, "Unexpected end of expression");
        RETURN NIL;
    ENDIF;
    
    ch := get_char(state);
    
    CASE ch OF
        ORD('.'): 
            consume_char(state);
            RETURN create_dot_node();
        ORD('('):
            consume_char(state);
            RETURN parse_group(state);
        ORD('['):
            consume_char(state);
            RETURN parse_bracket(state);
        ORD('\\'):
            consume_char(state);
            RETURN parse_escape(state);
        ORD(')'): (* Unmatched closing parenthesis *)
            set_error(state, "Unmatched closing parenthesis");
            RETURN NIL;
        ORD('*'), ORD('+'), ORD('?'), ORD('{'), ORD('|'): (* Quantifiers/alternation at atom level are errors *)
            set_error(state, "Invalid use of operator");
            RETURN NIL;
        OTHERWISE:
            consume_char(state);
            RETURN create_char_node(ch);
    ENDCASE;
ENDPROC;

(* Parses a group (...) *)
PROC parse_group(VAR state: ParserState) -> ^ASTNode;
VAR
    child: ^ASTNode;
    node: ^GroupNode;
BEGIN
    child := parse_alternation(state); (* Group contents can be any full expression *)
    IF state.error THEN RETURN NIL; ENDIF;
    
    IF state.position >= state.length OR get_char(state) # ORD(')') THEN
        destroy_ast(child);
        set_error(state, "Unmatched opening parenthesis");
        RETURN NIL;
    ENDIF;
    consume_char(state); (* Consume ')' *)
    
    (* Create GroupNode *)
    ALLOCATE(node, 1);
    node.base.base.type := Common.GROUP_NODE;
    node.base.child := child;
    state.group_counter := state.group_counter + 1;
    node.base.group_id := state.group_counter;
    RETURN CAST<^ASTNode>(node);
ENDPROC;

(* Parses a bracket expression [...] *)
PROC parse_bracket(VAR state: ParserState) -> ^ASTNode;
VAR
    node: ^BracketNode;
    negated: BOOLEAN;
    ch: U32;
    i: I32;
BEGIN
    ALLOCATE(node, 1);
    node.base.base.type := Common.BRACKET_NODE;
    node.base.char_count := 0;
    node.base.range_count := 0;
    node.base.class_count := 0;
    
    negated := FALSE;
    IF state.position < state.length AND get_char(state) = ORD('^') THEN
        negated := TRUE;
        consume_char(state);
    ENDIF;
    node.base.negated := negated;
    
    (* Handle special case where ']' is first character *)
    IF state.position < state.length AND get_char(state) = ORD(']') THEN
        ch := get_char(state);
        consume_char(state);
        IF node.base.char_count < 256 THEN
            node.base.chars[node.base.char_count] := ch;
            node.base.char_count := node.base.char_count + 1;
        ENDIF;
    ENDIF;
    
    WHILE state.position < state.length AND get_char(state) # ORD(']') DO
        ch := get_char(state);
        
        (* Check for range *)
        IF state.position + 1 < state.length AND state.input[state.position + 1] = ORD('-') AND
           state.position + 2 < state.length AND state.input[state.position + 2] # ORD(']') THEN
            consume_char(state); (* Consume first char *)
            consume_char(state); (* Consume '-' *)
            IF node.base.range_count < 128 THEN
                node.base.ranges[node.base.range_count].start := ch;
                node.base.ranges[node.base.range_count].end := get_char(state);
                node.base.range_count := node.base.range_count + 1;
            ENDIF;
            consume_char(state); (* Consume last char of range *)
        ELSE
            (* Single character *)
            consume_char(state);
            IF node.base.char_count < 256 THEN
                node.base.chars[node.base.char_count] := ch;
                node.base.char_count := node.base.char_count + 1;
            ENDIF;
        ENDIF;
    ENDWHILE;
    
    IF state.position >= state.length THEN
        (* Free node *)
        FREE(node);
        set_error(state, "Unmatched opening bracket");
        RETURN NIL;
    ENDIF;
    consume_char(state); (* Consume ']' *)
    
    RETURN CAST<^ASTNode>(node);
ENDPROC;

(* Parses an escape sequence *)
PROC parse_escape(VAR state: ParserState) -> ^ASTNode;
VAR ch: U32;
    seq_val: U32;
BEGIN
    IF state.position >= state.length THEN
        set_error(state, "Unexpected end after escape character");
        RETURN NIL;
    ENDIF;
    ch := get_char(state);
    consume_char(state);
    
    (* Handle common escapes *)
    CASE ch OF
        ORD('n'): seq_val := 10; (* Newline *)
        ORD('t'): seq_val := 9;  (* Tab *)
        ORD('r'): seq_val := 13; (* Carriage return *)
        ORD('\\'): seq_val := ORD('\\');
        ORD('.'): seq_val := ORD('.');
        ORD('['): seq_val := ORD('[');
        ORD(']'): seq_val := ORD(']');
        ORD('('): seq_val := ORD('(');
        ORD(')'): seq_val := ORD(')');
        ORD('{'): seq_val := ORD('{');
        ORD('}'): seq_val := ORD('}');
        ORD('|'): seq_val := ORD('|');
        ORD('*'): seq_val := ORD('*');
        ORD('+'): seq_val := ORD('+');
        ORD('?'): seq_val := ORD('?');
        ORD('^'): seq_val := ORD('^');
        ORD('$'): seq_val := ORD('$');
        OTHERWISE: seq_val := ch; (* Treat as literal *)
    ENDCASE;
    
    RETURN create_escape_node(seq_val);
ENDPROC;

(* Parses a quantifier (*, +, ?, {m,n}) *)
PROC parse_quantifier(VAR state: ParserState, atom: ^ASTNode) -> ^ASTNode;
VAR ch: U32;
    greedy: BOOLEAN;
BEGIN
    IF state.position >= state.length THEN RETURN atom; ENDIF;
    
    ch := get_char(state);
    greedy := TRUE; (* Default is greedy *)
    
    (* Check for non-greedy prefix .* (non-standard) *)
    IF ch = ORD('.') THEN
        (* Peek ahead for * *)
        IF state.position + 1 < state.length AND state.input[state.position + 1] = ORD('*') THEN
            greedy := FALSE;
            consume_char(state); (* Consume '.' *)
            consume_char(state); (* Consume '*' *)
            ch := ORD('*'); (* Treat as * quantifier but non-greedy *)
        ELSE
            RETURN atom; (* '.' is part of the atom, not a quantifier prefix *)
        ENDIF;
    ENDIF;
    
    CASE ch OF
        ORD('*'):
            consume_char(state);
            RETURN create_kleene_node(atom, greedy);
        ORD('+'):
            consume_char(state);
            RETURN create_plus_node(atom, greedy);
        ORD('?'):
            consume_char(state);
            RETURN create_question_node(atom, greedy);
        ORD('{'):
            consume_char(state);
            RETURN parse_boundary(state, atom, greedy);
        OTHERWISE:
            RETURN atom; (* No quantifier *)
    ENDCASE;
ENDPROC;

(* Parses a boundary quantifier {m,n} *)
PROC parse_boundary(VAR state: ParserState, atom: ^ASTNode, greedy: BOOLEAN) -> ^ASTNode;
VAR
    node: ^BoundaryNode;
    min_val: I32;
    max_val: I32;
    ch: U32;
BEGIN
    min_val := 0;
    max_val := -1; (* -1 means infinity/unspecified *)
    
    (* Parse min value *)
    WHILE state.position < state.length AND get_char(state) >= ORD('0') AND get_char(state) <= ORD('9') DO
        min_val := min_val * 10 + (get_char(state) - ORD('0'));
        consume_char(state);
    ENDWHILE;
    
    IF state.position >= state.length THEN
        set_error(state, "Incomplete boundary quantifier");
        RETURN NIL;
    ENDIF;
    
    ch := get_char(state);
    IF ch = ORD(',') THEN
        consume_char(state);
        (* Parse max value *)
        max_val := 0;
        WHILE state.position < state.length AND get_char(state) >= ORD('0') AND get_char(state) <= ORD('9') DO
            max_val := max_val * 10 + (get_char(state) - ORD('0'));
            consume_char(state);
        ENDWHILE;
        IF max_val = 0 THEN max_val := -1; ENDIF; (* If no digits after comma, it's infinity *)
    ELSE
        max_val := min_val; (* {n} is same as {n,n} *)
    ENDIF;
    
    IF state.position >= state.length OR get_char(state) # ORD('}') THEN
        set_error(state, "Missing closing brace in boundary quantifier");
        RETURN NIL;
    ENDIF;
    consume_char(state); (* Consume '}' *)
    
    (* Create BoundaryNode *)
    ALLOCATE(node, 1);
    node.base.base.base.type := Common.BOUNDARY_NODE;
    node.base.base.child := atom;
    node.base.base.greedy := greedy;
    node.base.min := min_val;
    node.base.max := max_val;
    RETURN CAST<^ASTNode>(node);
ENDPROC;

(* === Helper Functions for AST Node Creation === *)

PROC create_char_node(ch: U32) -> ^ASTNode;
VAR node: ^CharNode;
BEGIN
    ALLOCATE(node, 1);
    node.base.base.type := Common.CHAR_NODE;
    node.base.char := ch;
    RETURN CAST<^ASTNode>(node);
ENDPROC;

PROC create_dot_node() -> ^ASTNode;
VAR node: ^DotNode;
BEGIN
    ALLOCATE(node, 1);
    node.base.base.type := Common.DOT_NODE;
    RETURN CAST<^ASTNode>(node);
ENDPROC;

PROC create_escape_node(seq: U32) -> ^ASTNode;
VAR node: ^EscapeNode;
BEGIN
    ALLOCATE(node, 1);
    node.base.base.type := Common.ESCAPE_NODE;
    node.base.sequence := seq;
    RETURN CAST<^ASTNode>(node);
ENDPROC;

PROC create_kleene_node(child: ^ASTNode, greedy: BOOLEAN) -> ^ASTNode;
VAR node: ^KleeneNode;
BEGIN
    ALLOCATE(node, 1);
    node.base.base.base.type := Common.KLEENE_NODE;
    node.base.base.child := child;
    node.base.base.greedy := greedy;
    RETURN CAST<^ASTNode>(node);
ENDPROC;

PROC create_plus_node(child: ^ASTNode, greedy: BOOLEAN) -> ^ASTNode;
VAR node: ^PlusNode;
BEGIN
    ALLOCATE(node, 1);
    node.base.base.base.type := Common.PLUS_NODE;
    node.base.base.child := child;
    node.base.base.greedy := greedy;
    RETURN CAST<^ASTNode>(node);
ENDPROC;

PROC create_question_node(child: ^ASTNode, greedy: BOOLEAN) -> ^ASTNode;
VAR node: ^QuestionNode;
BEGIN
    ALLOCATE(node, 1);
    node.base.base.base.type := Common.QUESTION_NODE;
    node.base.base.child := child;
    node.base.base.greedy := greedy;
    RETURN CAST<^ASTNode>(node);
ENDPROC;

PROC create_boundary_node(child: ^ASTNode, min: I32, max: I32, greedy: BOOLEAN) -> ^ASTNode;
VAR node: ^BoundaryNode;
BEGIN
    ALLOCATE(node, 1);
    node.base.base.base.type := Common.BOUNDARY_NODE;
    node.base.base.child := child;
    node.base.base.greedy := greedy;
    node.base.min := min;
    node.base.max := max;
    RETURN CAST<^ASTNode>(node);
ENDPROC;

(* === Utility Functions === *)

PROC get_char(VAR state: ParserState) -> U32;
BEGIN
    IF state.position < state.length THEN
        RETURN state.input[state.position];
    ENDIF;
    RETURN 0; (* Or some EOF indicator *)
ENDPROC;

PROC consume_char(VAR state: ParserState);
BEGIN
    IF state.position < state.length THEN
        state.position := state.position + 1;
    ENDIF;
ENDPROC;

PROC set_error(VAR state: ParserState, msg: ARRAY[*] OF U8);
VAR i: I32;
BEGIN
    state.error := TRUE;
    (* Copy msg to state.error_msg *)
    i := 0;
    WHILE i < 255 AND msg[i] # 0 DO
        state.error_msg[i] := msg[i];
        i := i + 1;
    ENDWHILE;
    state.error_msg[i] := 0; (* Null terminate *)
ENDPROC;

(* Simple AST destruction (in a real implementation, this would be more complex) *)
PROC destroy_ast(node: ^ASTNode);
BEGIN
    IF node = NIL THEN RETURN; ENDIF;
    
    CASE node.type OF
        Common.CONCAT_NODE:
            destroy_ast(CAST<^ConcatNode>(node).base.left);
            destroy_ast(CAST<^ConcatNode>(node).base.right);
        Common.ALTERNATION_NODE:
            destroy_ast(CAST<^AlternationNode>(node).base.left);
            destroy_ast(CAST<^AlternationNode>(node).base.right);
        Common.KLEENE_NODE, Common.PLUS_NODE, Common.QUESTION_NODE, Common.BOUNDARY_NODE:
            destroy_ast(CAST<^QuantifierNode>(node).base.child);
        Common.GROUP_NODE:
            destroy_ast(CAST<^GroupNode>(node).base.child);
        (* For other node types, no children to destroy *)
    ENDCASE;
    
    FREE(node);
ENDPROC;

ENDMODULE;

