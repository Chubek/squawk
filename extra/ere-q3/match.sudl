(* match.sudl *)
(* Module for matching strings against compiled ERE NFAs using NFA simulation *)

MODULE "match.sudl"

USES "MODULE" "common.sudl" AS Common;
USES "MODULE" "compile.sudl" AS Compile;

(* === Matching Configuration === *)
(* Assuming MAX_STATES is defined in common.sudl or compile.sudl *)
(* CONST MAX_STATES = ...; *)

(* === Matching Data Structures === *)

(* Represents the result of a match operation *)
TYPE MatchResult = RECORD {
    found: BOOLEAN; (* TRUE if a match was found *)
    start: I32; (* Start index of the match in the input string (0-based) *)
    end: I32; (* End index of the match in the input string (0-based, exclusive) *)
    (* Note: Submatches are not implemented in this basic version *)
}

(* Internal state for the NFA simulator *)
TYPE NFAStateSet = ARRAY[Compile.MAX_STATES] OF BOOLEAN;
TYPE NFAMatcher = RECORD {
    nfa: ^Compile.NFA; (* The NFA to simulate *)
    current_states: NFAStateSet; (* Set of states active in the current step *)
    next_states: NFAStateSet; (* Set of states for the next step *)
}

(* === Internal Helper Functions === *)

(* Adds a state to the state set *)
PROC add_state(states: ^NFAStateSet, state_id: I32);
BEGIN
    IF state_id >= 0 AND state_id < Compile.MAX_STATES THEN
        states[state_id] := TRUE;
    ENDIF;
ENDPROC;

(* Clears all states from the state set *)
PROC clear_states(states: ^NFAStateSet);
VAR i: I32;
BEGIN
    FOR i := 0 TO Compile.MAX_STATES - 1 DO
        states[i] := FALSE;
    ENDFOR;
ENDPROC;

(* Checks if a state is in the state set *)
PROC is_state_in_set(states: ^NFAStateSet, state_id: I32) -> BOOLEAN;
BEGIN
    IF state_id >= 0 AND state_id < Compile.MAX_STATES THEN
        RETURN states[state_id];
    ENDIF;
    RETURN FALSE;
ENDPROC;

(* Computes the epsilon closure of a state set *)
(* This populates the 'closure' set with all states reachable from 'states' via epsilon transitions *)
PROC epsilon_closure(nfa: ^Compile.NFA, states: ^NFAStateSet, closure: ^NFAStateSet);
VAR
    i, j: I32;
    changed: BOOLEAN;
    trans: ^Compile.Transition;
BEGIN
    (* Initialize closure with the input states *)
    FOR i := 0 TO Compile.MAX_STATES - 1 DO
        closure[i] := states[i];
    ENDFOR;
    
    (* Iteratively add states reachable by epsilon transitions *)
    changed := TRUE;
    WHILE changed DO
        changed := FALSE;
        (* Iterate through all epsilon transitions in the NFA *)
        FOR i := 0 TO nfa.num_transitions - 1 DO
            trans := &nfa.transitions[i];
            IF trans.type = Compile.TRANS_EPSILON AND is_state_in_set(closure, trans.from) THEN
                IF NOT is_state_in_set(closure, trans.to) THEN
                    add_state(closure, trans.to);
                    changed := TRUE;
                ENDIF;
            ENDIF;
        ENDFOR;
    ENDWHILE;
ENDPROC;

(* === Main Matching Logic === *)

(* Finds the longest match starting at a specific position in the string *)
(* Returns TRUE if a match is found, and updates 'result' *)
PROC find_longest_match_at_position(matcher: ^NFAMatcher, input: ^U8, input_len: I32, start_pos: I32, result: ^MatchResult) -> BOOLEAN;
VAR
    i, j: I32;
    current_char: U8;
    trans: ^Compile.Transition;
    temp_closure: NFAStateSet;
    longest_match_end: I32; (* End index of the longest match found so far *)
BEGIN
    result.found := FALSE;
    result.start := -1;
    result.end := -1;
    longest_match_end := -1;
    
    IF start_pos < 0 OR start_pos > input_len THEN RETURN FALSE; ENDIF;
    
    (* --- NFA Simulation Loop --- *)
    (* Initialize current states with epsilon closure of the NFA's start state *)
    clear_states(&matcher.current_states);
    add_state(&matcher.current_states, matcher.nfa.start_state);
    epsilon_closure(matcher.nfa, &matcher.current_states, &matcher.current_states);
    
    i := start_pos; (* Current position in the input string *)
    WHILE i <= input_len DO (* Go one past the end to handle empty matches at the end *)
        (* Check for acceptance at the current state set *)
        IF is_state_in_set(&matcher.current_states, matcher.nfa.accept_state) THEN
            longest_match_end := i; (* Record the end of this potential match *)
        ENDIF;
        
        (* If we've reached the end of the input, stop *)
        IF i = input_len THEN BREAK; ENDIF;
        
        current_char := input[i];
        
        (* --- Compute next set of states --- *)
        clear_states(&matcher.next_states);
        
        (* Find all states reachable by consuming 'current_char' *)
        FOR j := 0 TO matcher.nfa.num_transitions - 1 DO
            trans := &matcher.nfa.transitions[j];
            IF is_state_in_set(&matcher.current_states, trans.from) THEN
                IF (trans.type = Compile.TRANS_CHAR AND trans.char_val = current_char) OR
                   (trans.type = Compile.TRANS_DOT) THEN
                    add_state(&matcher.next_states, trans.to);
                ENDIF;
            ENDIF;
        ENDFOR;
        
        (* Compute epsilon closure of the next states *)
        epsilon_closure(matcher.nfa, &matcher.next_states, &temp_closure);
        (* Copy closure back to next_states *)
        FOR j := 0 TO Compile.MAX_STATES - 1 DO
            matcher.next_states[j] := temp_closure[j];
        ENDFOR;
        
        (* --- Advance to next step --- *)
        (* Copy next_states to current_states for the next iteration *)
        FOR j := 0 TO Compile.MAX_STATES - 1 DO
            matcher.current_states[j] := matcher.next_states[j];
        ENDFOR;
        
        (* If no states are active, no further matching is possible from this path *)
        (* We can check this, but the loop condition handles it implicitly *)
        
        i := i + 1;
    ENDWHILE;
    
    (* --- Determine final result --- *)
    IF longest_match_end # -1 THEN
        result.found := TRUE;
        result.start := start_pos;
        result.end := longest_match_end;
        RETURN TRUE;
    ENDIF;
    
    RETURN FALSE;
ENDPROC;

(* The main matching function that finds the first (leftmost) longest match *)
(* This adheres to POSIX ERE matching rules: find the leftmost match, and among those, the longest *)
PROC MatchERE(nfa: ^Compile.NFA, input: ^U8, input_len: I32, result: ^MatchResult) -> BOOLEAN;
VAR
    matcher: NFAMatcher;
    i: I32;
    temp_result: MatchResult;
BEGIN
    result.found := FALSE;
    result.start := -1;
    result.end := -1;
    
    IF nfa = NIL OR input = NIL OR result = NIL THEN RETURN FALSE; ENDIF;
    
    matcher.nfa := nfa;
    clear_states(&matcher.current_states);
    clear_states(&matcher.next_states);
    
    (* --- Main Loop: Try to match from each position in the string --- *)
    (* This ensures we find the leftmost match *)
    FOR i := 0 TO input_len DO
        IF find_longest_match_at_position(&matcher, input, input_len, i, &temp_result) THEN
            (* Found a match starting at position i *)
            IF NOT result.found OR temp_result.end > result.end THEN
                (* This is the first match found, or a longer match than previously found *)
                (* Since we are going left-to-right, the first one is the leftmost *)
                result.found := TRUE;
                result.start := temp_result.start;
                result.end := temp_result.end;
                (* Break after the first match is found, as it's the leftmost *)
                BREAK;
            ENDIF;
        ENDIF;
    ENDFOR;
    
    RETURN result.found;
ENDPROC;

ENDMODULE;

